{
  "manifest_version": 3,
  "name": "LeetPush",
  "version": "1.0.0",
  "description": "Automatically pushes your accepted LeetCode solutions to GitHub, one commit per problem. © 2026 AnhEmSoftware.",
  "author": "AnhEmSoftware",
  "homepage_url": "https://anhemsoftware.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "inject/leetcode.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "LeetPush",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
